  "atmospheres": [
    {
      "location_name": "Ashen Gate",
      "text": "Wind slips through the broken towers, carrying the smell of cold iron."
    },
    {
      "location_name": "Hollow Market",
      "text": "A shutter moves by itself. Somewhere behind the empty stalls, coins clink once."
    },
    {
      "location_name": "Old Shrine",
      "text": "Ash gathers in the altar's cracks. Whatever stirred here has not forgotten the road."
    },
    {
      "location_name": "Charred Watchtower",
      "text": "The watchtower bell gives a single dull knock, though no hand touches it."
    },
    {
      "location_name": "Mourning Fields",
      "text": "Pale grass bends around old stones, exposing scraps of names beneath the ash."
    },
    {
      "location_name": "Blackroot Hollow",
      "text": "Black roots shift under the soil with a sound like distant breathing."
    },
    {
      "location_name": "Drowned Chapel",
      "text": "Water laps against the chapel steps. Far below, something answers with a bell note."
    },
    {
      "location_name": "Sootbound Crossing",
      "text": "Old wheel tracks divide at the crossing, then vanish where the ash has been disturbed."
    }
  ],
